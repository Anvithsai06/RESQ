# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # backend only, never exposed to frontend

# ── Backend ───────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENV=development                                    # development | production

# ── Vision / models ───────────────────────────────────────
YOLO_MODEL_PATH=models/yolo/best.pt
HAZARD_YOLO_MODEL_PATH=models/yolo/fire_smoke.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
BYTETRACK_CONFIG_PATH=configs/bytetrack.yaml
DEMO_VIDEO_PATH=data/demo/emergency_scene.mp4
ANNOTATED_VIDEO_PATH=data/demo/annotated_scene.mp4  # rendered by scripts/render_annotated_demo.py
FRAME_SAMPLE_RATE=5                                 # process every Nth frame

# ── Pipeline run mode (affects pacing only, never what is detected) ──
RESQ_RUN_PIPELINE=false                             # true = run the real pipeline on startup
RESQ_PIPELINE_REALTIME=false                        # true = pace ticks to the video's own timeline
RESQ_PIPELINE_LOOP=false                            # true = replay the clip continuously
RESQ_DEV_SEED_DEMO_INCIDENT=false                   # dev only: synthetic scenario, no models needed

# ── Building / scene config ──────────────────────────────
BUILDING_CONFIG_PATH=building/building.json
CAMERAS_CONFIG_PATH=building/cameras.json
ZONES_CONFIG_PATH=building/zones.json
EXITS_CONFIG_PATH=building/exits.json
EMERGENCY_CONTACTS_CONFIG_PATH=building/emergency_contacts.json
THRESHOLDS_CONFIG_PATH=configs/thresholds.json

# ── Notification engine ──────────────────────────────────
NOTIFICATION_PROVIDER=mock                          # mock | twilio | smtp | webhook
NOTIFICATION_COOLDOWN_SECONDS=120
NOTIFICATION_PERSISTENCE_SECONDS=10
CRITICAL_PRIORITY_THRESHOLD=80

# Twilio (only if NOTIFICATION_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP (only if NOTIFICATION_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Generic webhook (only if NOTIFICATION_PROVIDER=webhook)
NOTIFICATION_WEBHOOK_URL=

# ── Frontend (frontend/.env, mirrored here for reference) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_BACKEND_API_URL=http://localhost:8000
